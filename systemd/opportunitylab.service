[Unit]
Description=opportunitylab fake-money research daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pumpwatch
WorkingDirectory=/home/pumpwatch/opportunitylab
EnvironmentFile=/home/pumpwatch/pumpwatch/.env
EnvironmentFile=-/home/pumpwatch/opportunitylab/.env
ExecStart=/usr/bin/python3 -m opportunity_lab.main run
Restart=always
RestartSec=15
MemoryMax=220M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pumpwatch/opportunitylab
InaccessiblePaths=/home/pumpwatch/pumpwatch/wallet.json

[Install]
WantedBy=multi-user.target
