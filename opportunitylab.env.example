LAB_STARTING_CASH_USD=100
LAB_SCAN_INTERVAL_SECONDS=300
LAB_TIMEZONE=America/New_York
LAB_DAILY_DIGEST_HOUR=20

LAB_ENABLE_FUNDING=1
LAB_ENABLE_KALSHI=1
LAB_ENABLE_POLYMARKET_US=1
LAB_ENABLE_NEWS=1
LAB_ENABLE_FAST_BTC=1
LAB_AUTO_PAPER_TRADE=1

LAB_PREDICTION_MIN_VOLUME_USD=50
LAB_PREDICTION_MIN_NET_EDGE=0.015
LAB_PAPER_TRADE_BUDGET_USD=5
LAB_PAPER_MAX_ALLOCATION_USD=40
LAB_PAPER_MAX_OPEN_TRADES=8

LAB_FAST_POLL_SECONDS=3
LAB_FAST_ACTIVE_WINDOW_SECONDS=45
LAB_FAST_ENTRY_WINDOW_SECONDS=20
LAB_FAST_MIN_SECONDS_LEFT=2.5
LAB_FAST_MIN_EDGE=0.06
LAB_FAST_UNCONFIRMED_EDGE_PENALTY=0.03
LAB_FAST_MIN_MARGIN_BPS=1.5
LAB_FAST_MAX_ASK=0.92
LAB_FAST_TRADE_BUDGET_USD=5
LAB_FAST_MAX_OPEN_TRADES=2

LAB_AI_MODEL=gpt-5.6-luna
LAB_AI_REASONING_EFFORT=low
LAB_MAX_AI_CALLS_PER_DAY=20
LAB_MAX_AI_USD_PER_DAY=0.10
LAB_MAX_AI_OUTPUT_TOKENS=550
AI_REQUIRED_FOR_ENTRY=1

